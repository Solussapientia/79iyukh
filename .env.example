# Copy this file to ".env" and fill in your real values. NEVER commit .env.

# Your Stripe LIVE secret key (starts with sk_live_...).
# Find it at: https://dashboard.stripe.com/apikeys
# Keep this secret. It must only ever live on the server / in this file.
STRIPE_SECRET_KEY=sk_live_xxx

# (Optional) Default reader ID to charge on (starts with tmr_...).
# Leave blank and the web page will let you pick from your online readers.
# Find it at: https://dashboard.stripe.com/terminal/readers
READER_ID=

# Currency for charges (ISO code). Default: usd
CURRENCY=usd

# Port the local server runs on.
PORT=4242
